{
  "name": "shadowlab-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "HOSTNAME=127.0.0.1 PORT=3000 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "postbuild": "node -e \"require('node:fs').cpSync('.next/static','.next/standalone/.next/static',{recursive:true})\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-query": "5.90.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
