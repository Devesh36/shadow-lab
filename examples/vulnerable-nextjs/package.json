{
  "name": "shadowlab-disposable-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "HOSTNAME=127.0.0.1 PORT=3001 node .next/standalone/server.js",
    "postbuild": "node -e \"require('node:fs').cpSync('.next/static','.next/standalone/.next/static',{recursive:true})\""
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
