# Local-only defaults. Generate a strong API token before exposing the API.
SHADOWLAB_API_TOKEN=
SHADOWLAB_DATABASE_URL=sqlite:///.shadowlab/shadowlab.db
SHADOWLAB_REPOSITORY_ROOT=.
SHADOWLAB_DATA_DIR=.shadowlab
# Optional provider key: enter in your local environment; never commit it.
# SHADOWLAB_LLM_API_KEY=
# SHADOWLAB_LLM_MODEL=openai/gpt-4o-mini
# SHADOWLAB_LLM_BASE_URL=http://127.0.0.1:11434
